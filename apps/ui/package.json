    "@lingui/react": "^6.6.0",
    "@maintainerr/contracts": "workspace:^",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.101.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "axios": "^1.18.1",
    "bowser": "^2.14.1",
    "clsx": "^2.1.1",
    "compare-versions": "^6.1.1",
